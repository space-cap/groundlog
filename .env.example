# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 Git에 올리지 않습니다)
# Supabase 대시보드 > Project Settings > API 에서 확인

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# anon 또는 publishable key (브라우저 노출 가능, 접근 제어는 RLS 가 담당)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 비밀키. 절대 NEXT_PUBLIC_ 접두사를 붙이지 말고, 클라이언트 코드에서 import 하지 마세요.
# 직원 계정 생성 등 관리자 기능 구현 시 필요합니다 (아직 사용하지 않음).
# SUPABASE_SERVICE_ROLE_KEY=

